# Copy this file to .env and fill in the values for local development.
# For production, set these as environment variables on Vercel instead of
# committing a .env file to the repository.

# URL of the deployed backend API (no trailing slash).
# Local default (used automatically when this variable is not set):
#   http://localhost:8000
VITE_API_BASE_URL=https://your-app-name.onrender.com
